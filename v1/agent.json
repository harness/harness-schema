{
  "type" : "object",
  "title" : "agent",
  "additionalProperties" : false,
  "required" : [ "agent" ],
  "properties" : {
    "version" : {
      "type" : "number",
      "enum" : [ 1 ]
    },
    "agent" : {
      "$ref" : "#/definitions/agent/AgentSpec"
    }
  },
  "examples" : [ {
    "agent" : {
      "uses" : "harnessAI@1.0.0",
      "inputs" : {
        "test-input" : {
          "type" : "string",
          "required" : true
        }
      },
      "with" : {
        "connector" : "account.harnessLLM",
        "prompt" : "print all the available mcp for ${{inputs.test-input}}",
        "mcp" : [ "harnessMcp", "Traceable" ],
        "max_turns" : "150",
        "env" : {
          "ANTHROPIC_MODEL" : "claude-sonnet-5"
        }
      }
    }
  }, {
    "agent" : {
      "uses" : "harnessAI@1.0.0",
      "with" : {
        "prompt" : "list available mcps\nlist available pipelines in this project\nprint the value of $GREET",
        "env" : {
          "GREET" : "${{inputs.test}}"
        },
        "allowed_domains" : "pubmed.mcp.claude.com, api.githubcopilot.com",
        "max_turns" : "50",
        "workdir" : "/harness",
        "image" : "harness/harness-ai-agent:latest",
        "docker_connector" : "${{inputs.docker.id}}",
        "connector" : "${{inputs.llm.id}}",
        "mcp" : "${{inputs.mcpCon}}"
      },
      "inputs" : {
        "test" : {
          "type" : "string",
          "default" : "test-value"
        },
        "docker" : {
          "type" : "connector",
          "default" : "account.harnessImage",
          "ui" : {
            "connectorCategories" : [ "ARTIFACTORY" ]
          }
        },
        "llm" : {
          "type" : "connector",
          "default" : "account.harnessLLM",
          "ui" : {
            "connectorCategories" : [ "AI" ]
          }
        },
        "mcpCon" : {
          "type" : "array",
          "default" : [ "harnessMcp", "Traceable" ],
          "ui" : {
            "input" : {
              "inputType" : "connector",
              "inputConfig" : {
                "connectorTypes" : [ "Mcp" ]
              }
            }
          }
        }
      }
    }
  } ],
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "definitions" : {
    "agent" : {
      "AgentSpec" : {
        "title" : "AgentSpec",
        "description" : "Agent YAML",
        "type" : "object",
        "additionalProperties" : false,
        "required" : [ "uses", "with" ],
        "properties" : {
          "uses" : {
            "description" : "Harness AI agent type and version (for example harnessAI@1.0.0).",
            "type" : "string",
            "pattern" : "^harnessAI(@[0-9]+\\.[0-9]+\\.[0-9]+)?$"
          },
          "with" : {
            "description" : "Agent configuration object. Fields under with other than prompt (for example connector) may be a fixed value or a runtime input such as ${{inputs.llm.id}}. with itself cannot be a runtime expression.",
            "allOf" : [ {
              "$ref" : "#/definitions/agent/HarnessAIWith"
            } ]
          },
          "inputs" : {
            "description" : "Runtime inputs for this agent. Reference them from fields under with as ${{inputs.<name>}}.",
            "$ref" : "#/definitions/pipeline/common/NGVariableV1Wrapper"
          }
        },
        "$schema" : "http://json-schema.org/draft-07/schema#"
      },
      "HarnessAIWith" : {
        "title" : "HarnessAIWith",
        "description" : "Agent configuration object. Fields other than prompt may be a fixed value or a runtime input such as ${{inputs.<name>}}. The with mapping itself cannot be a runtime expression.",
        "type" : "object",
        "additionalProperties" : false,
        "required" : [ "prompt", "connector" ],
        "properties" : {
          "prompt" : {
            "description" : "Natural-language instruction for the agent to perform. Must be a fixed string. Input expressions such as ${{inputs.name}} may appear inside the prompt text.",
            "type" : "string",
            "minLength" : 1
          },
          "connector" : {
            "description" : "Model Provider connector identifier. Can be a fixed connector ref or a runtime input such as ${{inputs.llm.id}}.",
            "type" : "string",
            "minLength" : 1
          },
          "docker_connector" : {
            "description" : "Docker or artifact registry connector used to pull the agent image. Can be a fixed connector ref or a runtime input.",
            "type" : "string"
          },
          "image" : {
            "description" : "Container image for the agent runner. Can be a fixed image name or a runtime input.",
            "type" : "string"
          },
          "mcp" : {
            "description" : "MCP connectors for the agent. Can be a list of connector refs or a runtime input such as ${{inputs.mcpCon}}.",
            "oneOf" : [ {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            }, {
              "$ref" : "#/definitions/pipeline/common/Expression"
            } ]
          },
          "max_turns" : {
            "description" : "Maximum number of agent iterations before the run is terminated. Can be a number, a quoted string, or a runtime input.",
            "oneOf" : [ {
              "type" : "string"
            }, {
              "type" : "number"
            } ]
          },
          "workdir" : {
            "description" : "Working directory for the agent. Defaults to /harness when unset. Can be a fixed path or a runtime input.",
            "type" : "string"
          },
          "skill" : {
            "description" : "Optional path to a SKILL.md file to install into the working directory before the run. Can be a fixed path or a runtime input.",
            "type" : "string"
          },
          "allowed_tools" : {
            "description" : "Comma-separated allowlist of tools the agent may use. Empty uses the runner default. Can be a fixed string or a runtime input.",
            "type" : "string"
          },
          "allowed_domains" : {
            "description" : "Extra domains the agent may reach (exact hosts, optional wildcards, or domain regexes). Can be a fixed string or a runtime input.",
            "type" : "string"
          },
          "permissions" : {
            "description" : "Resource to action map (for example, pipeline - execute) copied onto the agent's run steps to scope the injected HARNESS_TOKEN.",
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "env" : {
            "description" : "Extra environment variables for the agent. Values may be fixed strings or runtime inputs such as ${{inputs.test}}.",
            "oneOf" : [ {
              "type" : "object",
              "additionalProperties" : {
                "type" : "string"
              }
            }, {
              "type" : "array"
            }, {
              "$ref" : "#/definitions/pipeline/common/Expression"
            } ]
          }
        },
        "$schema" : "http://json-schema.org/draft-07/schema#"
      }
    },
    "pipeline" : {
      "common" : {
        "Expression" : {
          "title" : "Expression",
          "description" : "String value matching a Harness pipeline expression or template placeholder (e.g., <+something> or ${{ ... }}).",
          "type" : "string",
          "pattern" : "(\\$\\{\\{.+\\}\\}|<\\+.+>.*)",
          "$schema" : "http://json-schema.org/draft-07/schema#"
        },
        "NGVariableV1Wrapper" : {
          "title" : "NGVariableV1Wrapper",
          "description" : "Wrapper for stage/pipeline-level input variables. Keys are variable names, values define variable configuration.",
